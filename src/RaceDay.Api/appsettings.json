{
  "ConnectionStrings": {
    "RaceDayDb": "Server=(localdb)\\MSSQLLocalDB;Database=RaceDayApiDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "Issuer": "RaceDay.Api",
    "Audience": "RaceDay.Clients",
    "Key": "DEV-ONLY-change-me-RaceDay-signing-key-2026-at-least-32-chars",
    "ExpiryMinutes": 120
  },
  "AzureStorage": {
    "_comment": "Paste the storage account connection string here, or set AzureStorage__ConnectionString as an environment variable so it stays out of source control. Leave it empty and image uploads answer 503 while the rest of the API works normally.",
    "ConnectionString": "",
    "EventBannersContainer": "event-banners",
    "ProfilePicturesContainer": "profile-pictures",
    "MaxFileSizeMb": 5
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
