@model OrganiserDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="container">
    <div class="rd-page-head">
        <div>
            <h1 class="mb-1">Dashboard</h1>
            <p class="rd-meta mb-0">Everything you are running, at a glance.</p>
        </div>
        <a class="btn btn-rd" asp-action="Create">Create an event</a>
    </div>

    <dl class="rd-stats mb-4">
        <div class="rd-stat">
            <dt>Events created</dt>
            <dd>@Model.TotalEvents</dd>
        </div>
        <div class="rd-stat">
            <dt>Upcoming</dt>
            <dd>@Model.UpcomingCount</dd>
        </div>
        <div class="rd-stat">
            <dt>Total entries</dt>
            <dd>@Model.TotalEnrolments</dd>
        </div>
        <div class="rd-stat">
            <dt>Next event</dt>
            <dd>@(Model.NextEvent is null ? "-" : Model.NextEvent.EventDate.ToString("d MMM"))</dd>
        </div>
    </dl>

    @if (!Model.Events.Any())
    {
        <div class="rd-empty">
            <h3>You have not created an event yet</h3>
            <p>Set up the event, add the distances you are offering, and entries can start coming in.</p>
            <a class="btn btn-rd mt-3" asp-action="Create">Create your first event</a>
        </div>
    }
    else
    {
        @if (Model.AwaitingResults.Any())
        {
            <div class="rd-panel rd-panel-pad mb-4 d-flex flex-wrap justify-content-between align-items-center gap-3">
                <div>
                    <h2 class="h5 mb-1">Results to capture</h2>
                    <p class="rd-meta mb-0">
                        @Model.AwaitingResults.Count race@(Model.AwaitingResults.Count == 1 ? " has" : "s have")
                        taken place. Participants are waiting for their times.
                    </p>
                </div>
                <a class="btn btn-rd" asp-action="Results" asp-route-id="@Model.AwaitingResults.First().EventId">
                    Capture @Model.AwaitingResults.First().Name
                </a>
            </div>
        }

        <div class="row g-4">
            <div class="col-lg-7">
                <h2 class="h4 mb-3">Coming up</h2>

                @if (!Model.Upcoming.Any())
                {
                    <div class="rd-panel rd-panel-pad">
                        <p class="rd-meta mb-0">Nothing scheduled. Your past events are under My events.</p>
                    </div>
                }
                else
                {
                    <div class="rd-table-wrap">
                        <table class="rd-table">
                            <thead>
                            <tr>
                                <th>Event</th>
                                <th>Date</th>
                                <th class="rd-num">Entries</th>
                                <th>Status</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var raceEvent in Model.Upcoming)
                            {
                                <tr>
                                    <td>
                                        <a asp-action="Enrolments" asp-route-id="@raceEvent.EventId">@raceEvent.Name</a>
                                        <div class="rd-meta">@raceEvent.City</div>
                                    </td>
                                    <td>@raceEvent.EventDate.ToString("ddd d MMM")</td>
                                    <td class="rd-num">
                                        @raceEvent.EnrolledCount@(raceEvent.MaxParticipants.HasValue ? $" / {raceEvent.MaxParticipants}" : "")
                                    </td>
                                    <td><partial name="_StatusBadge" model="raceEvent.Status" /></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="col-lg-5">
                <h2 class="h4 mb-3">Entries by event</h2>
                <div class="rd-panel rd-panel-pad">
                    @{
                        var busiest = Model.Events
                            .Where(e => e.EnrolledCount > 0)
                            .OrderByDescending(e => e.EnrolledCount)
                            .Take(6)
                            .ToList();
                        var highest = busiest.FirstOrDefault()?.EnrolledCount ?? 1;
                    }

                    @if (!busiest.Any())
                    {
                        <p class="rd-meta mb-0">No entries have come in yet.</p>
                    }
                    else
                    {
                        @foreach (var raceEvent in busiest)
                        {
                            var width = (int)Math.Round(raceEvent.EnrolledCount * 100.0 / Math.Max(highest, 1));
                            <div class="mb-3">
                                <div class="d-flex justify-content-between align-items-baseline">
                                    <span>@raceEvent.Name</span>
                                    <span class="rd-figure">@raceEvent.EnrolledCount</span>
                                </div>
                                <div style="height:6px;background:var(--rd-line);border-radius:3px;overflow:hidden;">
                                    <div style="width:@(width)%;height:100%;background:var(--rd-brand);"></div>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>
    }
</div>
