@model ProfileViewModel
@{
    ViewData["Title"] = "My profile";
}

<div class="container">
    <div class="rd-page-head">
        <div>
            <h1 class="mb-1">My profile</h1>
            <p class="rd-meta mb-0">@Model.Profile.Email</p>
        </div>
    </div>

    <form asp-action="Profile" method="post" enctype="multipart/form-data" novalidate>
        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="rd-panel rd-panel-pad">
                    <h2 class="h5 mb-3">Profile picture</h2>

                    @if (!string.IsNullOrEmpty(Model.Profile.ProfilePictureUrl))
                    {
                        <img src="@Model.Profile.ProfilePictureUrl" alt="Your profile picture"
                             class="img-fluid rounded mb-3" style="aspect-ratio:1;object-fit:cover;" />
                    }
                    else
                    {
                        <div class="rd-event-media--empty rounded mb-3"
                             style="aspect-ratio:1;display:grid;place-items:center;">
                            <span>No picture yet</span>
                        </div>
                    }

                    <label asp-for="ProfilePicture" class="form-label"></label>
                    <input asp-for="ProfilePicture" class="form-control" type="file" accept="image/*" />
                    <span asp-validation-for="ProfilePicture" class="text-danger small"></span>
                    <p class="rd-meta mt-2 mb-0">JPEG, PNG or WebP, up to 5MB.</p>
                </div>
            </div>

            <div class="col-lg-8">
                <div class="rd-panel rd-panel-pad">
                    <h2 class="h5 mb-3">Your details</h2>

                    <div class="row g-3">
                        <div class="col-sm-6">
                            <label asp-for="FirstName" class="form-label"></label>
                            <input asp-for="FirstName" class="form-control" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="LastName" class="form-label"></label>
                            <input asp-for="LastName" class="form-control" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="PhoneNumber" class="form-label"></label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="DateOfBirth" class="form-label"></label>
                            <input asp-for="DateOfBirth" class="form-control" type="date" />
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="Gender" class="form-label">Gender</label>
                            <select asp-for="Gender" class="form-select">
                                <option value="">Prefer not to say</option>
                                @foreach (var gender in RegisterViewModel.Genders)
                                {
                                    <option value="@gender" selected="@(gender == Model.Gender)">@gender</option>
                                }
                            </select>
                        </div>
                        <div class="col-sm-6">
                            <label asp-for="City" class="form-label"></label>
                            <input asp-for="City" class="form-control" />
                        </div>
                    </div>

                    <button type="submit" class="btn btn-rd mt-4">Save changes</button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
