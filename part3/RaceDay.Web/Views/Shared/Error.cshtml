@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="rd-panel rd-panel-pad my-5 text-center">
                <h1 class="mb-2">Something went wrong</h1>
                <p class="rd-lede mx-auto mb-4">
                    The request did not complete. Nothing you entered has been lost, and trying again
                    usually clears it.
                </p>
                <a class="btn btn-rd" asp-controller="Home" asp-action="Index">Back to RaceDay</a>

                @if (Model?.ShowRequestId ?? false)
                {
                    <p class="rd-meta mt-4 mb-0">Reference: <code>@Model.RequestId</code></p>
                }
            </div>
        </div>
    </div>
</div>
